rules_version = '2';

// 브라우저(학생·교사 모두)는 Firestore를 직접 읽거나 쓸 수 없습니다.
// 모든 읽기·쓰기는 앱 서버(/api/...)가 권한을 확인한 뒤 서버용 키로 합니다.
// 서버용 키(Admin SDK)는 이 규칙의 적용을 받지 않습니다.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
